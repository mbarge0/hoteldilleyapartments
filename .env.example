# Env vars for /buy financial-package auto-send.
# Set these in the Netlify UI for the hoteldilley.com site (Site settings > Environment variables).
# Do not commit real values. The From domain must be verified in Resend before production sends work.

RESEND_API_KEY=
PACKAGE_FROM_EMAIL=Hotel Dilley <offers@hoteldilley.com>
PACKAGE_NOTIFY_EMAIL=
